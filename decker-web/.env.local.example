# Variables de entorno del proyecto.
#
# Este archivo es la PLANTILLA y se versiona. El archivo real es `.env.local`,
# que no se commitea nunca (ya está en .gitignore).
#
# Para trabajar: copiar este archivo a `.env.local`.
#
# El instructivo completo está en CLAUDE.md, sección "La API de Ruta Sur".


# ¿De dónde salen las unidades del catálogo?
#
#   true  → de los arrays de lib/data/unidades.ts (los datos de prueba)
#   false → de la API de Ruta Sur
#
# Sólo el valor exacto `false` prende la API. Cualquier otra cosa —vacía, un
# typo, `FALSE`— deja los datos de prueba: un error de tipeo acá no puede
# terminar en un catálogo vacío en producción.
USE_MOCK_DATA=false

# La API de Ruta Sur. Sin barra al final.
#
# Se puede dejar vacía: el código ya usa esta URL por defecto, porque es pública
# y fija. La variable está para poder apuntar a un staging sin tocar código.
RUTASUR_API_URL=https://xapi.rutasurtrucks.com.ar

# ---------------------------------------------------------------------------
# LO DE ABAJO TODAVÍA NO LO TENEMOS. El catálogo, las agencias, los banners y
# el envío de consultas son PÚBLICOS y andan sin nada de esto.
#
# La key hace falta para `/precios` —hoy el sitio publica todas las unidades
# como "Consultar" porque la API no devuelve precio en ningún endpoint
# público— y para los endpoints de escritura, que todavía no están
# documentados.
# ---------------------------------------------------------------------------

# La API key, si Eduardo manda una ya generada. Se manda como `X-API-KEY`.
#
# NO agregarle el prefijo NEXT_PUBLIC_. Ese prefijo hace que Next inserte el
# valor dentro del JavaScript que baja el navegador, y ahí la key queda a la
# vista de cualquiera. Si un componente cliente necesita datos protegidos, la
# forma correcta es pedirlos a una ruta de /api, que le pega a la API desde el
# servidor. Ver app/api/unidades/route.ts.
RUTASUR_API_KEY=

# Credenciales, si en vez de una key ya generada tenemos usuario y contraseña.
# Con estas dos, el servidor saca la key solo con `PUT /key` y la guarda en
# memoria. Ver lib/rutasur/clave.ts.
RUTASUR_API_USER=
RUTASUR_API_PASSWORD=

# ---------------------------------------------------------------------------
# COTIZACIÓN DEL DÓLAR
# ---------------------------------------------------------------------------

# Respaldo del dólar oficial venta, en pesos. OPCIONAL y normalmente vacía.
#
# La cotización sale en vivo del endpoint de Banco Nación de DolarAPI —pública,
# sin clave, nada que configurar acá— y se revalida cada una hora. Ver
# lib/dolar.ts.
#
# Esta variable existe sólo para el caso en que DolarAPI esté caída y el
# proceso todavía no haya visto ningún valor bueno. Le gana a la constante del
# repo, así que permite corregir el respaldo sin un deploy de código.
#
# Vacía, el respaldo es `dolarOficialVenta` de lib/data/financiacion.ts.
DOLAR_OFICIAL_VENTA_RESPALDO=
